# Supabase — Project Settings → API
# The key is labelled "anon public" on older projects and "Publishable key" on newer ones.
# Either works. Never put the service_role / secret key in this file — the app doesn't need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is reachable. Used to build invite links.
# Local: http://localhost:3000   Production: https://syncin.love
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs invite links so a database leak yields no working links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVITE_SECRET=
